{
  "name": "project-sync",
  "version": "0.2.0",
  "description": "Cross-tool mismatch detection & resolution for developer workflows",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "project-sync": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "demo": "PROJECTSYNC_MODE=demo node src/http-server.js",
    "demo:live": "PROJECTSYNC_MODE=live node src/http-server.js",
    "demo:mcp": "PROJECTSYNC_MODE=demo node src/server.js",
    "doctor": "node scripts/doctor.js",
    "hackathon": "node scripts/hackathon.mjs",
    "hackathon:live": "node scripts/hackathon.mjs --live",
    "rehearse": "node scripts/rehearse.mjs",
    "deliverable": "npm test && npm run rehearse && node scripts/package-deliverable.mjs",
    "test": "node --test test/*.test.js deploy/*.test.mjs",
    "aws:plan": "python3 scripts/aws.py plan",
    "aws:package": "python3 scripts/aws.py package"
  },
  "engines": { "node": ">=20.12.0" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.6.7"
  }
}
