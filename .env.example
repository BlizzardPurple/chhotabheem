# Copy to .env on the machine used for the demo. This file contains placeholders.
# GitLab: full namespace/path, not the website URL. Numeric project ID also works.
GITLAB_PROJECT=YOUR_GROUP/YOUR_PROJECT
GITLAB_HOST=https://gitlab.com
# Leave unset to reuse glab auth login on the teammate's machine.
# GITLAB_TOKEN=YOUR_GITLAB_PERSONAL_ACCESS_TOKEN

JIRA_PROJECT=DEMO
JIRA_URL=https://YOUR_ORG.atlassian.net
JIRA_DONE_STATUS=Done
# If jira CLI is already configured, leave REST credential variables unset.
# Set JIRA_TRANSPORT=cli to force reuse of that CLI (including its JIRA_API_TOKEN).
# JIRA_TRANSPORT=cli
# Jira Cloud REST alternative:
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=YOUR_JIRA_API_TOKEN
# JIRA_TRANSPORT=rest
# Jira Server/Data Center REST alternative:
# JIRA_TOKEN=YOUR_JIRA_PERSONAL_ACCESS_TOKEN
# JIRA_DEPLOYMENT=server

REVIEW_STALE_DAYS=3
PORT=3021
# Optional: existing clasp OAuth or a short-lived Drive access token.
# GOOGLE_ACCESS_TOKEN=YOUR_DRIVE_ACCESS_TOKEN
# PROJECTSYNC_HOME=/absolute/path/to/private/notebook
# Do not set PROJECTSYNC_PUBLIC_DEMO for live local operation.
